<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Status area: tapping it opens the app -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="0 mL"
                android:textColor="@color/status_ok"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/consumed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:text="0 / 2000 mL"
                android:textColor="@color/widget_text"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Esperado agora: 0 mL"
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:indeterminate="false"
            android:max="1000"
            android:progress="0"
            android:progressDrawable="@drawable/widget_progress" />
    </LinearLayout>

    <!-- Quick-add buttons: only add water, never open the app -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_100"
            style="@style/WidgetButton"
            android:text="100" />

        <TextView
            android:id="@+id/btn_180"
            style="@style/WidgetButton"
            android:layout_marginStart="6dp"
            android:text="180" />

        <TextView
            android:id="@+id/btn_500"
            style="@style/WidgetButton"
            android:layout_marginStart="6dp"
            android:text="500" />

        <TextView
            android:id="@+id/btn_700"
            style="@style/WidgetButton"
            android:layout_marginStart="6dp"
            android:text="700" />

        <TextView
            android:id="@+id/btn_undo"
            style="@style/WidgetButton"
            android:layout_marginStart="6dp"
            android:contentDescription="Desfazer"
            android:text="↶"
            android:textSize="18sp" />
    </LinearLayout>
</LinearLayout>
